# Шаблон переменных окружения. Копируется в .env и заполняется реальными значениями.
# Файл .env в git не попадает (см. .gitignore). Здесь — только имена и заглушки,
# настоящие токены сюда писать нельзя.

# Токен для доступа к GitHub (например, чтобы скил tracker коммитил прогоны
# в olegserbat/tracker-data). Scope: repo.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Пример стороннего API-ключа
# SOME_API_KEY=xxxxxxxx
